# Copy to .env (gitignored). Values already set in the environment take priority.

# Cloudflare tunnel, used with --tunnel
CLOUDFLARE_TUNNEL=my-tunnel
STREAM_HOSTNAME=stream.example.com

# Spot relay
SPOT_HOSTNAME=192.168.80.3
SPOT_CAMERA=front
# Leave blank to be prompted at startup
BOSDYN_CLIENT_USERNAME=
BOSDYN_CLIENT_PASSWORD=

# Thermal relay
RTSP_URL=rtsp://192.168.80.102/avc
